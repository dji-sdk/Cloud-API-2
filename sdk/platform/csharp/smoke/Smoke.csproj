    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SdkVersion Condition="'$(SdkVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION').Trim())</SdkVersion>
