# Copy to .env and fill real values. Do not commit .env.
FHSDK_ADDRESS=http://YOUR_FH_SERVER_HOST
FHSDK_PORT=30812
FHSDK_NOTIFICATION_SERVER=ws://YOUR_FH_SERVER_HOST:30812/openapi/v0.9/notification/ws/v1/notifications
FHSDK_AUTH_HEADER_KEY=user_id
FHSDK_AUTH_HEADER_VALUE=

# Backend container WHIP must hit Oryx on the shared docker network (not host.docker.internal).
# Browser WHEP still uses host-mapped 12022.
ORYX_WHIP_URL_TEMPLATE=http://fhsdk-demo-oryx:2022/rtc/v1/whip/?app=live&stream={streamKey}
ORYX_WHEP_URL_TEMPLATE=http://127.0.0.1:12022/rtc/v1/whep/?app=live&stream={streamKey}
ORYX_PUBLISH_SECRET=

# H264 / HEVC(EA340) 混用：auto 按首帧 Annex-B 识别；仅 HEVC 会按 LIVE_TRANSCODE_TO_H264 转码。
LIVE_INPUT_FORMAT=auto
LIVE_TRANSCODE_TO_H264=true
