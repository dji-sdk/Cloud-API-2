# DJI Cloud API 2 MCP Server Configuration
# Copy this file to .env and fill in your values

# DJI Cloud API 2 Server Connection (required)
FH_SERVER_ADDRESS=https://your-server.com
FH_SERVER_PORT=443
FH_ACCESS_TOKEN=your-workspace-access-token
FH_WORKSPACE_UUID=your-workspace-binding-uuid

# WSS 通知通道 TLS 证书校验（私有化自签名部署可选）
# FH_VERIFY_SSL=true            # 默认 true；仅在受控内网的自签名部署才设为 false
# FH_SSL_CA_PATH=/certs/ca.pem  # 自签 CA 路径，仅在 FH_VERIFY_SSL=true 时生效

# Platform Gateway Auth (required for real SDK)
# 平台网关要求的额外鉴权头，与 skeleton 的 fh.skeleton.sdk.real.http-auth-header-key/value 对齐
FH_HTTP_AUTH_KEY=user_id
FH_HTTP_AUTH_VALUE=your-auth-value

# Security
# FH_MAX_SECURITY_LEVEL — 生产环境建议 2（允许飞行控制，禁止 L3 紧急停机）
#   仅在需要远程触发紧急停机时显式设为 3，且必须同时配置 FH_OPERATOR_TOKEN
FH_MAX_SECURITY_LEVEL=2
# FH_OPERATOR_TOKEN — L3（紧急停止）运营商二次鉴权 Token，AI 不可代填，真人带外提供
#   未配置时 L3 操作一律拒绝执行（fail-safe）。启用 L3 时用强随机值：
#     openssl rand -hex 32
FH_OPERATOR_TOKEN=REPLACE_WITH_openssl_rand_hex_32_OUTPUT
FH_MOCK=false

# Output budget (optional)
# 单次 tool 响应超过阈值时，截断超长列表/字符串并注入 output_truncated 元信息，
# 避免超大 SDK 响应（如十万行日志）耗尽 LLM 的 token
# ⚠️ 以下 4 项在 OutputBudgetGuard 构造时读取一次，修改后需重启进程生效
# FH_OUTPUT_BUDGET_ENABLED=true   # 总开关，默认开启
# FH_OUTPUT_MAX_BYTES=262144      # 单次响应上限（pretty-print 后字节数），默认 256KB
# FH_OUTPUT_MAX_ARRAY_ITEMS=500   # 单个列表最多保留条数
# FH_OUTPUT_MAX_STRING_CHARS=8192 # 单个字符串最多保留字符数

# Transport (default: sse in Docker)
FH_TRANSPORT=sse
FH_SSE_PORT=8080
# ⚠️ 必填：SSE 模式鉴权 token，留空或使用公知占位值均会被 StartupAuthValidator 拒绝启动
# 生成强随机 token（切勿使用下方占位值原样部署）：
#   openssl rand -hex 32
# 然后将生成的值填入此处：
FH_SSE_AUTH_TOKEN=REPLACE_WITH_openssl_rand_hex_32_OUTPUT

# Heartbeat / Connection management (optional)
# FH_HEARTBEAT_INTERVAL=30000    # Heartbeat broadcast interval (ms), default 30s
# FH_HEARTBEAT_TIMEOUT=300       # Idle timeout before disconnect (seconds), default 300s (5 min)
# FH_GRACE_PERIOD=60             # Reconnect grace period (seconds), default 60s

# Cockpit (optional) - live stream monitoring UI
# When set, takeoff success response will include a cockpit URL for real-time drone monitoring
# FH_COCKPIT_URL=http://localhost:5177

# KMZ local path upload (optional) — fh_workspace submit 的本地路径通道
# 允许 importKmz 读取的 KMZ 目录，默认 /tmp（stdio 本机运行，与客户端同一文件系统）。
# 容器化运行时必须指向挂载点，否则客户端生成的 .kmz 在容器内不可见：
#   - docker-compose：由 FH_WAYLINE_HOST_DIR 挂到 /data/waylines（见 docker-compose.yml）
#   - run-mcp-docker.sh：宿主机 /tmp 只读挂到 /data/waylines
# ⚠️ MCP 与客户端不在同一台机器（远程 SSE）时该通道不可用，请改用对象存储 key 提交
# FH_WAYLINE_UPLOAD_DIR=/data/waylines

# Rate Limiting (SSE mode only)
# FH_RATE_LIMIT_MAX=100              # 单 IP 每窗口最大请求数，默认 100
# FH_RATE_LIMIT_WINDOW_SECONDS=60    # 窗口时长（秒），默认 60
# FH_RATE_LIMIT_TRUST_PROXY=false    # 是否信任 X-Forwarded-For 头（仅在受信反向代理后启用），默认 false
# FH_RATE_LIMIT_MAX_KEYS=10000      # 最大跟踪 IP 数量（防 OOM），默认 10000

# Tool-level Rate Limiting (stdio + SSE, keyed by sessionId + toolName [+ deviceSn] [+ action])
# 防止大模型逻辑死循环在一分钟内重复调用同一高成本 Tool 上千次。
# 只拒绝不再排队：超限返回 success=false + rate_limited=true，不阻塞线程。
# 同一 session 下按设备（drone_sn / dock_sn / device_sn）隔离配额，多台飞机互不挤占。
# FH_TOOL_RATE_LIMIT_ENABLED=true   # 工具级限流总开关，默认 true
# FH_TOOL_RATE_LIMIT_L0_RPM=300     # L0 只读工具每分钟配额，默认 300
# FH_TOOL_RATE_LIMIT_L1_RPM=30      # L1 可逆工具每分钟配额，默认 30
# FH_TOOL_RATE_LIMIT_L2_RPM=6       # L2 飞行工具每分钟配额，默认 6
# FH_TOOL_RATE_LIMIT_L3_RPM=0       # L3 紧急工具配额，0 = 不限流（建议保持 0，紧急停止必须永远可执行）
# FH_TOOL_RATE_LIMIT_MAX_KEYS=10000 # 最大跟踪 (session, tool, device, action) 桶数，超限 fail-open，默认 10000
# 单工具覆盖只能通过 YAML（application.yml 的 flighthub.rate-limit.per-tool-rpm）配置，
# 环境变量无法注入 map。默认已为以下高成本工具收紧配额：
#   fh_stick_move / fh_return_home / fh_wayline_execute = 2
#   fh_takeoff / fh_flyto = 3
#   fh_live_start = 5（约束 start / switch_source；stop / quality 属中止/查询类 action，
#                     自动跳过覆盖、只走 L1 档位并独占计数桶）
# 如需调整，改动 application.yml 中的 per-tool-rpm 段。

# CORS (SSE mode only)
# FH_CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://another.com

# ==============================================================================
# pf-device-simulator-service Connection (optional, for Sim* MCP tools)
# F-02 整改：密码无默认 fallback。未显式配置 FH_SIM_PASSWORD（或仍为公知弱值）时，
# 所有 Sim* 工具将拒绝调用（fail-fast）。请与模拟器 config.yaml 的
# auth.default_password 保持一致，建议随机生成，例如：
#   FH_SIM_PASSWORD=$(openssl rand -hex 16)
# ==============================================================================
# FH_SIM_BASE_URL=http://localhost:8000
# FH_SIM_USERNAME=admin
# FH_SIM_PASSWORD=
