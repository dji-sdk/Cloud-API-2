# DJI Cloud API 2 MCP Server 远端部署配置
# 用法：cp mcp/deploy.env.example mcp/deploy.env
#
# 首次配置 SSH 主机指纹（防 MITM 攻击）：
#   ssh-keyscan -p "${REMOTE_SSH_PORT:-22}" "${REMOTE_HOST}" > mcp/deploy_known_hosts
# 该文件按部署环境本地生成，**不入库**（.gitignore 已忽略）：host key 本身非密钥，
# 但文件内容包含目标主机地址，提交会暴露内网拓扑。
# 缺失时 deploy.sh 会自动 ssh-keyscan 生成；生成失败则拒绝连接（不会静默降级为 no）。
#
# ─── SSH 认证方式 ──────────────────────────────────────────────────────────
# 推荐：使用 SSH key-based 认证（更安全、可审计、易轮换）
#   1. 生成密钥对：ssh-keygen -t ed25519 -f ~/.ssh/deploy_key -C "deploy"
#   2. 部署公钥到远端：ssh-copy-id -i ~/.ssh/deploy_key.pub <user>@<host>
#   3. 删除下方 REMOTE_PASS 行，deploy.sh 将自动使用 SSH key 认证
#
# 不推荐（仅测试环境）：密码认证（需安装 sshpass，存在暴力破解和密码泄露风险）
#   保留 REMOTE_PASS 行即走密码认证，生产环境请务必迁移到 key-based 方式

REMOTE_HOST=<your-server-ip>
REMOTE_USER=<ssh-username>
# REMOTE_PASS=<ssh-password>  # 不推荐，仅测试环境使用。生产环境请删除此行，改用 SSH key
REMOTE_SSH_PORT=22
REMOTE_DIR=/opt/mcp
REMOTE_PORT=8080
