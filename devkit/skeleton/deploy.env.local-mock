# ============================================================================
# FH Skeleton 本地部署配置（Docker Compose + mock 模式）
# 生成时间: 2026-08-12
# 说明: 本机 Apple Silicon (arm64)，Docker Desktop 模拟 amd64 运行。
#       mock profile 不加载 SDK JNI 原生库，无需真实 SDK 凭据。
# ============================================================================

# ─── 运行模式 ──────────────────────────────────────────────────────────────
# mock: 本地演示/开发（无需真实 SDK）；sdk: 连接真实 FlightHub PaaS
FH_PROFILE=mock
# FH_SDK_MODE=mock 为可选项：application-mock.yml 已将 fh.skeleton.sdk.mode 设为 mock，
# 仅激活 mock profile 即可；显式设置便于阅读并防止 profile 与 mode 错配
FH_SDK_MODE=mock

# ─── 数据库（本地 compose 内置 MySQL 8.0）────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
FH_DB_USERNAME=root
FH_DB_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
FH_DB_USE_SSL=false

# ─── JWT 签名密钥（必填，HS256 至少 32 字节）────────────────────────────────
# 生成方式：openssl rand -hex 32
# 警告：CHANGE_ME 开头的值会被启动校验拒绝，
#       必须替换成随机值，否则后端启动即失败。
FH_JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# ─── MCP / Chat（关闭：mock 模式无需 MCP，且 RAG embedding 调用需有效 AI key）──
FH_CHAT_ENABLED=false
FH_CHAT_MCP_URL=http://localhost:8080
FH_CHAT_MCP_AUTH_TOKEN=

# ─── SDK 凭据（mock 模式不需要，留空）───────────────────────────────────────
FH_SKELETON_SDK_TOKEN=
FH_SKELETON_SDK_ADDRESS=
FH_SKELETON_SDK_PORT=443
FH_SKELETON_SDK_NOTIFICATION_SERVER=

# ─── 前端 FH2 配置（即使 mock 模式，前端仍需 FH2_ADDRESS 通过校验）──────────
VITE_FH2_ADDRESS=http://<your-fh2-server>
VITE_FH2_PORT=30812
VITE_FH2_WSS_URL=ws://<your-fh2-server>:30812/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_PRJ_ID=
VITE_FH2_SDK_AUTH_KEY=
VITE_FH2_SDK_AUTH_VALUE=
# mock 模式下 FH2 设备管理 SDK 无法连接平台 API，跳过 SDK 加载，回退为后端设备列表
VITE_FH2_DEVICE_SDK_ENABLED=false
VITE_DEFAULT_THEME=dark
VITE_PRIMARY_COLOR=#1a73e8
VITE_PRIMARY_HOVER_COLOR=
VITE_MOCK_ENABLED=false
VITE_MAP_PROVIDER=esri
VITE_BING_KEY=
VITE_TIANDITU_KEY=