# ============================================================================
# FH Skeleton systemd 环境变量模板（普通机器部署）
# 安装：sudo cp skeleton/deploy/skeleton.env.example /etc/fh-skeleton.env
#       sudo chown root:root /etc/fh-skeleton.env && sudo chmod 600 /etc/fh-skeleton.env
# 必填项：FH_JWT_SECRET / FH_DB_*（sdk profile 另需 FH_SKELETON_SDK_*）
# ============================================================================

# ─── Spring profile（生产用 sdk；本地 mock 勿用于生产）───
SPRING_PROFILES_ACTIVE=sdk

# ─── JWT（必填，至少 32 字节）───
FH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── 数据库（MySQL 8.0+）───
# FH_DB_USE_SSL 默认启用 SSL + requireSSL（生产强制 TLS）；本地开发连无 TLS 的 MySQL 时可置 false。
FH_DB_URL=jdbc:mysql://127.0.0.1:3306/fh_skeleton?useSSL=${FH_DB_USE_SSL:-true}&requireSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
FH_DB_USERNAME=fh_skeleton
FH_DB_PASSWORD=CHANGE_ME
FH_DDL_AUTO=update

# ─── SDK 连接（sdk profile 必填）───
FH_SKELETON_SDK_TOKEN=CHANGE_ME
FH_SKELETON_SDK_ADDRESS=CHANGE_ME
FH_SKELETON_SDK_PORT=443
FH_SKELETON_SDK_NOTIFICATION_SERVER=CHANGE_ME

# ─── Chat（可选，默认关闭）───
# FH_CHAT_ENABLED=false
# FH_CHAT_MCP_URL=http://127.0.0.1:8081
# FH_CHAT_MCP_AUTH_TOKEN=CHANGE_ME
# SPRING_AI_OPENAI_API_KEY=CHANGE_ME
# SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
# FH_CHAT_MODEL=deepseek-v4-flash-private

# ─── JVM 参数（可选）───
JAVA_OPTS=-Xms512m -Xmx2g
