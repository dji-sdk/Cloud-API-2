# ============================================================================
# FH Skeleton 远端部署配置模板
# 用法：cp skeleton/deploy.env.example skeleton/deploy.env
#
# 首次配置 SSH 主机指纹（防 MITM 攻击）：
#   ssh-keyscan -p "${REMOTE_SSH_PORT:-22}" "${REMOTE_HOST}" > skeleton/deploy_known_hosts
# deploy_known_hosts 可提交到 git（host key 非密钥）。
# ============================================================================

# ─── SSH 认证方式 ──────────────────────────────────────────────────────────
# 推荐：使用 SSH key-based 认证（更安全、可审计、易轮换）
#   1. 生成密钥对：ssh-keygen -t ed25519 -f ~/.ssh/deploy_key -C "deploy"
#   2. 部署公钥到远端：ssh-copy-id -i ~/.ssh/deploy_key.pub <user>@<host>
#   3. 删除下方 REMOTE_PASS 行，deploy.sh 将自动使用 SSH key 认证
#
# 不推荐（仅测试环境）：密码认证（需安装 sshpass，存在暴力破解和密码泄露风险）
#   保留 REMOTE_PASS 行即走密码认证，生产环境请务必迁移到 key-based 方式

# ─── 远端服务器 ─────────────────────────────────────────────────────────────
REMOTE_HOST=<your-server-ip>
REMOTE_USER=<ssh-username>
# REMOTE_PASS=<ssh-password>  # 不推荐，仅测试环境使用。生产环境请删除此行，改用 SSH key
REMOTE_SSH_PORT=22
REMOTE_DIR=/opt/skeleton

# ─── 镜像仓库（集成商自建环境必填，指向自有 Registry）──────────────────────────
# deploy-compose.yml 中所有 image 均通过 ${REGISTRY} 注入
REGISTRY=your-registry.example.com

# ─── 端口映射 ───────────────────────────────────────────────────────────────
BACKEND_PORT=8081
FRONTEND_PORT=8082

# ─── MySQL 数据库（必填，使用强随机密码）──────────────────────────────────────
# 安全发布专项修复：移除公知默认值 fh_skeleton_2024，未配置时启动失败
# 生成强随机密码：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=<replace-with-strong-random-password>
FH_DB_USERNAME=root
FH_DB_PASSWORD=<replace-with-strong-random-password>
# 生产环境强烈建议启用 SSL：
FH_DB_URL=jdbc:mysql://mysql:3306/fh_skeleton?useSSL=true&requireSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ─── JWT 签名密钥（必填，HS256 至少 32 字节）─────────────────────────────────
# 未配置时 compose 与服务端双重快速失败：
#   docker compose 阶段 → 缺 FH_JWT_SECRET 直接报错退出，不启动任何容器
#   服务启动阶段       → 仍为模板占位值（<...> / CHANGE_ME...）时拒绝启动
# 生成强随机密钥：openssl rand -hex 32
FH_JWT_SECRET=<replace-with-strong-random-key>

# ─── Spring AI（不配则 AI Chat 功能不可用，但不影响启动）────────────────────────
SPRING_AI_ANTHROPIC_API_KEY=
SPRING_AI_OPENAI_API_KEY=

# ─── Spring Boot 后端 ──────────────────────────────────────────────────────
# 远端部署默认 sdk 模式；仅在无 SDK 许可证的演示环境设为 mock（PAAS-ISV-06）
FH_PROFILE=sdk
# 开放注册（默认 false，外部审计 I-02）。初始化首个账号时临时设为 true，
# 首个注册用户自动成为 admin，创建完成后务必改回 false
FH_USER_REGISTRATION_ENABLED=false
FH_SKELETON_SDK_TOKEN=
FH_SKELETON_SDK_ADDRESS=
FH_SKELETON_SDK_PORT=443
FH_SKELETON_SDK_NOTIFICATION_SERVER=

# ─── MCP Server（独立部署，必填）─────────────────────────────────────────────
# MCP Server 由 mcp/docker-compose.yml 独立部署，不在此 compose 栈内。
# skeleton chatbot 通过此 URL 连接 MCP Server 获取 DJI Cloud API 2 工具能力。
FH_CHAT_MCP_URL=http://<your-mcp-host>:8080
# MCP Server SSE 鉴权 token（与 MCP Server 的 FH_SSE_AUTH_TOKEN 保持一致）
FH_CHAT_MCP_AUTH_TOKEN=

# ─── 前端变量（运行时注入，docker-entrypoint.sh 写入 config.js，重启容器生效）─────
# 注意：前端 VITE_* 全部是「运行时」环境变量，必须在 compose 的 environment（本文件经
# deploy.sh 导出）/ k8s ConfigMap 中提供，不要用 docker build --build-arg 传——
# 构建期传入的值会在容器启动时被 config.js 的运行时值覆盖，改了也不生效。
VITE_FH2_ADDRESS=http://<your-fh2-server>
VITE_FH2_PORT=30812
# 同源反代前缀（可选）：浏览器只与骨架本源通信，由 fh-ui 的 nginx 反代到 FH2，
# 规避 FH2 无 CORS 头的跨域拦截。留空则直连 VITE_FH2_ADDRESS。
#   例（经 HTTPS_PORT 对外）：VITE_FH2_ASSET_HOST=https://<your-skeleton-host>/fh2-assets
#                              VITE_FH2_BASE_URL=https://<your-skeleton-host>/fh2-gw
VITE_FH2_ASSET_HOST=
VITE_FH2_BASE_URL=
# 通知 ws 推送完整地址；留空则按 VITE_FH2_ADDRESS / VITE_FH2_PORT 自动推导（https 地址自动用 wss），
# 同源反代部署时通常留空即可（前端会拼成 <对外origin>/fh2-gw/openapi/v0.9/notification/ws/v1/notifications）。
# 仅在推导结果不符合预期时才显式覆盖，例如：
#   VITE_FH2_WSS_URL=wss://<your-skeleton-host>/fh2-gw/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_WSS_URL=
VITE_FH2_PRJ_ID=
# FH2 网关鉴权凭据（敏感）：由 nginx 反代注入 X-User-Token / auth_keys，不写入 config.js。
# 留空则透传浏览器原值（FH2 侧大概率 401，正式环境必须配置）。
VITE_FH2_USER_TOKEN=
VITE_FH2_SDK_AUTH_KEY=
VITE_FH2_SDK_AUTH_VALUE=
# FH2 上游 TLS 校验（反代侧，浏览器无感）：默认 on（fail-closed，安全审计 CICD-09）。
# 现场自签名证书需显式置 off，或挂载内网 CA 并用 FH2_PROXY_SSL_CA 指向容器内 CA 文件
# （宿主机路径需挂载进容器）。
# 未配置 CA 或路径无效时，自动回退镜像内置系统信任库 /etc/ssl/certs/ca-certificates.crt。
# 注意：verify=on 却完全找不到可用 CA 时，entrypoint 会 fail-closed 拒绝启动（不会降级为 off）。
FH2_PROXY_SSL_VERIFY=on
FH2_PROXY_SSL_CA=
VITE_DEFAULT_THEME=dark
VITE_PRIMARY_COLOR=#1a73e8
VITE_PRIMARY_HOVER_COLOR=
VITE_MOCK_ENABLED=false

# ─── 地图底图（运行时注入，修改后重启 fh-ui 容器生效，无需重新构建镜像）──────────
# 可选值：esri（默认，卫星影像，无需 key）| osm（矢量，无需 key）
#        bing（卫星+标注，需配置 VITE_BING_KEY）
#        tianditu（卫星+中文标注，需配置 VITE_TIANDITU_KEY，国内部署推荐）
VITE_MAP_PROVIDER=esri
VITE_BING_KEY=
VITE_TIANDITU_KEY=

# ─── HTTPS / SSL 终止（可选，配置后 deploy.sh 自动启用 fh-ssl 服务）──────────
# Web Speech API（语音输入）与 WebCodecs（340/O4 组网无人机 H265 直播硬解）都要求安全上下文。
# 前端容器自身只监听 8080 明文，TLS 统一由 fh-ssl 边车 / k8s ingress 终止。
#
# 集成商自建环境（无证书时可生成自签名）：
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout /opt/ssl/key.pem -out /opt/ssl/cert.pem -subj "/CN=<your-server-ip>"
#
# 留空则跳过 HTTPS（仅 HTTP 访问，语音输入在非 localhost 环境不可用）
SSL_CERT_PATH=
SSL_KEY_PATH=
# HTTPS 服务端口（默认 8083，避免与 drtc-traefik 占用的 8443 冲突）
HTTPS_PORT=8083
