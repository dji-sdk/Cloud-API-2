# ============================================================================
# FH Skeleton 本地部署配置（Docker Compose + SDK 模式）
# 说明: SDK profile 加载 SDK JNI 原生库，连接真实 FlightHub PaaS 平台。
#       如在 Apple Silicon 上运行，需设置 DOCKER_DEFAULT_PLATFORM=linux/amd64。
# ============================================================================

# ─── 运行模式 ──────────────────────────────────────────────────────────────
FH_PROFILE=sdk

# ─── 数据库（本地 compose 内置 MySQL 8.0）────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
FH_DB_USERNAME=root
FH_DB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
FH_DB_USE_SSL=false

# ─── JWT 签名密钥（随机生成）───────────────────────────────────────────────
FH_JWT_SECRET=CHANGE_ME_RANDOM_HEX_64

# ─── Spring AI（占位值，不配则 AnthropicApi Bean 初始化报 null）─────────────
SPRING_AI_ANTHROPIC_API_KEY=not-configured
SPRING_AI_OPENAI_API_KEY=not-configured

# ─── MCP / Chat（关闭：本地无 MCP Server）──────────────────────────────────
FH_CHAT_ENABLED=false
FH_CHAT_MCP_URL=http://localhost:8080
FH_CHAT_MCP_AUTH_TOKEN=

# ─── SDK 凭据 ──────────────────────────────────────────────────────────────
FH_SKELETON_SDK_TOKEN=
FH_SKELETON_SDK_ADDRESS=YOUR_FH_SERVER_IP
FH_SKELETON_SDK_PORT=443
FH_SKELETON_SDK_NOTIFICATION_SERVER=ws://YOUR_FH_SERVER_IP:443/openapi/v0.9/notification/ws/v1/notifications

# ─── SDK HTTP 鉴权 Header（平台网关鉴权）────────────────────────────────────
FH_SKELETON_SDK_AUTH_HEADER_KEY=user_id
FH_SKELETON_SDK_AUTH_HEADER_VALUE=YOUR_AUTH_VALUE

# ─── 前端 FH2 配置 ─────────────────────────────────────────────────────────
VITE_FH2_ADDRESS=http://YOUR_FH_SERVER_IP
VITE_FH2_PORT=443
VITE_FH2_WSS_URL=ws://YOUR_FH_SERVER_IP:443/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_PRJ_ID=
# ⚠️ 前端 SDK Auth Key/Value — 设备管理 SDK 需要此 header 鉴权连接 FH2 平台
VITE_FH2_SDK_AUTH_KEY=user_id
VITE_FH2_SDK_AUTH_VALUE=YOUR_AUTH_VALUE
VITE_FH2_DEVICE_SDK_ENABLED=true
VITE_DEFAULT_THEME=dark
VITE_PRIMARY_COLOR=#1a73e8
VITE_PRIMARY_HOVER_COLOR=
VITE_MOCK_ENABLED=false
VITE_MAP_PROVIDER=esri
VITE_BING_KEY=
VITE_TIANDITU_KEY=
