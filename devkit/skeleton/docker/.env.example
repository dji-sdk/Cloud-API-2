# ============================================================================
# FH Skeleton Docker 环境变量模板
# 复制本文件为 .env，填入真实值后 docker compose up
# ============================================================================

# Spring profile: mock（默认） / sdk
FH_PROFILE=mock

# SDK 凭据（仅 sdk profile 需要）
FH_SKELETON_SDK_TOKEN=your-workspace-token-here
FH_SKELETON_SDK_ADDRESS=api.example.com
FH_SKELETON_SDK_PORT=443
FH_SKELETON_SDK_NOTIFICATION_SERVER=wss://api.example.com/ws

# 端口映射（宿主机端口）
FH_PORT=8080

# ── FH2 服务器 ──────────────────────────────────────────
FH2_ADDRESS=http://your-fh2-server
FH2_PORT=30812
FH2_PRJ_ID=

# ── UI 主题 ─────────────────────────────────────────────
DEFAULT_THEME=dark
PRIMARY_COLOR=#1a73e8
PRIMARY_HOVER_COLOR=

# ── Mock 调试面板 ────────────────────────────────────────
MOCK_ENABLED=false
