<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dji.fh</groupId>
        <artifactId>fh-skeleton-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>feature-device</artifactId>

    <name>FH Skeleton Feature Device</name>
    <description>设备状态管理 feature module — 消费 KernelEvent，维护设备表 + OSD 快照 + HMS 告警，暴露 REST API。ISV 可参考的 feature 开发模板。</description>

    <dependencies>
        <!-- 自家 SPI（拿 event 类定义） -->
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>kernel-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web（REST 端点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
