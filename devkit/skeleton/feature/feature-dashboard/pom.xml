<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dji.fh</groupId>
        <artifactId>fh-skeleton-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>feature-dashboard</artifactId>
    <name>feature-dashboard</name>
    <description>看板数据聚合模块</description>

    <dependencies>
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>kernel-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>feature-device</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>feature-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SDK — optional, 仅 SDK 模式下 SdkDashboardAutoConfiguration 使用 -->
        <dependency>
            <groupId>com.dji.flighthubsdk</groupId>
            <artifactId>flight-hub-sdk</artifactId>
            <version>3.3.7</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- SDK 实现类依赖 JNI 原生库，单元测试环境无法实例化，需集成测试覆盖 -->
                    <excludes>
                        <exclude>com/dji/fh/feature/dashboard/spi/sdk/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
