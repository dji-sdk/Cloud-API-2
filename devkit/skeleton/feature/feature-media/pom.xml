<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dji.fh</groupId>
        <artifactId>fh-skeleton-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>feature-media</artifactId>

    <name>FH Skeleton Feature Media</name>
    <description>媒体文件管理 feature module — 照片/视频列表、下载、批量删除，基于 SDK MediaServiceModule。</description>

    <dependencies>
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>kernel-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dji.flighthubsdk</groupId>
            <artifactId>flight-hub-sdk</artifactId>
            <version>3.3.7</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- SDK 实现类依赖 JNI 原生库，单元测试环境无法实例化，需集成测试覆盖 -->
                    <excludes>
                        <exclude>com/dji/fh/feature/media/spi/sdk/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
