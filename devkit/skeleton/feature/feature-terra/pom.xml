<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dji.fh</groupId>
        <artifactId>fh-skeleton-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>feature-terra</artifactId>

    <name>FH Skeleton Feature Terra</name>
    <description>模型管理 feature module — 二维/三维模型全生命周期管理，基于 SDK TerraBuildModule。</description>

    <dependencies>
        <dependency>
            <groupId>com.dji.fh</groupId>
            <artifactId>kernel-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- FlightHub SDK（optional：仅 SDK 模式下需要，mock 模式不加载） -->
        <dependency>
            <groupId>com.dji.flighthubsdk</groupId>
            <artifactId>flight-hub-sdk</artifactId>
            <version>3.3.7</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- SDK 实现类依赖 JNI 原生库且需 SDK 初始化，单元测试环境无法覆盖回调分支，需集成测试覆盖 -->
                    <excludes>
                        <exclude>com/dji/fh/feature/terra/spi/sdk/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
