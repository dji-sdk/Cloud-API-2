# ── FH2 服务器 ──────────────────────────────────────────
VITE_FH2_ADDRESS=http://your-fh2-server   # 不含端口
VITE_FH2_PORT=30812
VITE_FH2_WSS_URL=                          # WebSocket 通知推送地址，例 ws://host:30812/openapi/v0.9/notification/ws/v1/notifications
VITE_FH2_PRJ_ID=

# ── 主题 ────────────────────────────────────────────────
VITE_DEFAULT_THEME=dark
VITE_PRIMARY_COLOR=#1a73e8
VITE_PRIMARY_HOVER_COLOR=

# ── 前端 Mock 数据源 ─────────────────────────────────────
# ⚠️ 置 true 会让 auth / wayline / flightTask / liveStream / dashboard 五个模块返回
#    前端本地假数据、不请求后端。其中 auth.login() 返回假 token
#    'mock-jwt-token-for-local-dev'。
#    而 devices / media / flightArea / terra / offlineMap / tcas 没有 mock 分支，
#    仍会请求真实后端 —— 假 token 撞真实后端得到 401，前端清登录态并跳回 /welcome。
#
#    仅在前端完全离线演示时置 true；与真实后端联调必须置 false。
#    注：容器部署时 config.js 的 MOCK_ENABLED 优先于这里的构建期值，改配置以 config.js 为准。
VITE_MOCK_ENABLED=false

# ── Mock 调试面板 ───────────────────────────────────────
# 控制侧边栏 / 用户菜单是否显示 /mock-debug 入口，以及该路由是否注册。
# 调试面板调用后端 MockRestController（/mock/devices/{sn}/*），与上面的前端假数据无关：
# 只想在 mock profile 后端上调试、但数据走真实接口时，单独置 true 即可。
# 路由在应用启动时按运行时配置注册，修改后需刷新页面才生效。
VITE_MOCK_DEBUG_PANEL=false

# ── 地图底图 ─────────────────────────────────────────────
# 可选值：esri（默认，卫星影像，需外网）
#        natural-earth（Cesium 内置 NaturalEarthII，低分辨率，需外网加载 CDN 资源）
#        osm（矢量，需外网）
#        bing（卫星+标注，需外网 + VITE_BING_KEY）
#        tianditu（卫星+中文标注，需外网 + VITE_TIANDITU_KEY）
VITE_MAP_PROVIDER=esri
VITE_BING_KEY=
VITE_TIANDITU_KEY=
